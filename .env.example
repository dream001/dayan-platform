# Published ports
FRONTEND_PORT=8887
BACKEND_PORT=5001
POSTGRES_PORT=5434
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Application
APP_ENVIRONMENT=docker
SPRING_PROFILES_ACTIVE=docker
VITE_API_BASE_URL=/api/v1
API_PROXY_TARGET=http://localhost:5001
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=dayan-platform
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=7d
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8887
INITIAL_ADMIN_ENABLED=true
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_DISPLAY_NAME=System Administrator
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change_me_now_2026

# PostgreSQL
POSTGRES_DB=dayan
POSTGRES_USER=dayan
POSTGRES_PASSWORD=dayan_dev_password

# MinIO
MINIO_ROOT_USER=dayan_minio
MINIO_ROOT_PASSWORD=dayan_minio_password
MINIO_BUCKET=dayan-files
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
FILE_MAX_SIZE=100MB
FILE_MAX_REQUEST_SIZE=101MB
FILE_ALLOWED_CONTENT_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain,text/csv,application/zip,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet
FILE_PREVIEW_TTL=5m
